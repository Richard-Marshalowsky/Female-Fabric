{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "female-fabric",
  "main": "worker.py",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SITE_URL": "https://female-fabric.workers.dev",
    "CORS_ORIGINS": "*",
    "AUTO_CREATE_TABLES": "true"
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "scripts/**/*"
  ]
}
