{
  "name": "female-fabric",
  "main": "src/worker.py",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SITE_URL": "https://female-fabric.workers.dev",
    "CORS_ORIGINS": "*",
    "AUTO_CREATE_TABLES": "false"
  },
  "observability": {
    "enabled": true
  }
}
