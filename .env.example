# Server settings
SITE_URL=https://female-fabric.workers.dev
SECRET_KEY=female-fabric-super-secure-secret-key-2026-xyz987
CORS_ORIGINS=*

# Database configuration
# Local development (SQLite):
DATABASE_URL=sqlite:///./female_fabric.db
# Production (Supabase PostgreSQL):
# DATABASE_URL=postgresql+pg8000://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Auto database migration on startup (set to false in production after running migration)
AUTO_CREATE_TABLES=true

# Optional: Supabase Storage for Admin Uploads in Cloudflare Workers
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_STORAGE_BUCKET=uploads
