# Server settings
SITE_URL=https://female-fabric.workers.dev
SECRET_KEY=female-fabric-super-secure-secret-key-change-this-in-production
CORS_ORIGINS=*

# Database configuration
# Local development (SQLite):
DATABASE_URL=sqlite:///./female_fabric.db

# Production (Supabase PostgreSQL with pg8000 driver):
# Get connection string from Supabase: Project Settings → Database → Connection String (Session mode)
# Replace 'postgres://' with 'postgresql+pg8000://'
# Example:
# DATABASE_URL=postgresql+pg8000://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Auto database migration on startup (set to false in production after first deploy)
AUTO_CREATE_TABLES=true

# Optional: Supabase Storage for Admin Uploads
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_STORAGE_BUCKET=uploads
